datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Empresa {
  id                    String     @id @default(uuid())
  rut                   String     @unique
  nombre                String
  razon_social          String?
  domicilio_fiscal      String?
  telefono              String?
  email                 String?
  proyectos             Proyecto[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model Proyecto {
  id                   String     @id @default(uuid())
  empresaId            String
  convenio             String?    @unique
  fecha_inicio         String?
  empresa              Empresa    @relation(fields: [empresaId], references: [id])
  fecha_creacion       String
  facturas             Factura[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([empresaId])
}

model Factura {
  id                    String    @id @default(uuid())
  proyectoId            String?
  proyecto              Proyecto? @relation(fields: [proyectoId], references: [id])
  archivo               String?
  descripcion           String?
  serie_factura         String?
  numero_factura        String?
  razon_social_emisor   String?
  rut_emisor            String?
  fecha                 String?
  fecha_vto             String?
  monto                 Float?
  moneda                String?
  cantidad              Int?      @default(1)
  rubro                 String?
  rut_receptor          String?
  razon_social_receptor String?
  texto_extraido        Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([proyectoId])
}

model Rubro {
  id                    String    @id @default(uuid())
  codigo_rubro          String?
  descripcion           String
}
